<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MMD provides composable theme; this is a minimal placeholder. -->
    <style name="Theme.CalmMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- No scrollbars: a list moves a page to a swipe, and nothing else needs one. -->
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>
    </style>

    <!-- The lock-screen strip's window: no animation in or out. The system otherwise animated it
         away, holding it on screen for 300-500 ms after an unlock, which on e-ink is the strip
         seen lingering over the home screen. -->
    <style name="LockStripWindow">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
