<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the phone, on Android 12 and newer. See backup_rules.xml for the reasoning:
  the settings file carries the music server's password and the YouTube cookie, and goes
  nowhere - not to a cloud backup, and not to a new phone either, where the keystore key that
  would unseal it does not exist.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="calmmusic_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <exclude domain="sharedpref" path="calmmusic_settings.xml"/>
    </device-transfer>
</data-extraction-rules>
